# 运行时设置 (含 API Key, 不入库)
settings.json

# Python 虚拟环境
.venv/
venv/
env/

# uv 缓存与临时文件
.uv/
uv.lock.bak

# Python 编译产物
__pycache__/
*.py[cod]
*$py.class
*.so

# 数据库 (运行时生成)
vibe_reading.db
vibe_reading.db-journal
vibe_reading.db-*
*.db
*.sqlite
*.sqlite3

# 上传的 TXT 文件 (运行时生成)
uploads/*
!uploads/.gitkeep

# 静态目录占位
static/*
!static/.gitkeep
!static/style.css

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# 日志
*.log
